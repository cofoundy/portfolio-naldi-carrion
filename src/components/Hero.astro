---
import { siteConfig } from "../config";
---

<!-- Neon gradient top bar -->
<div
  class="w-full h-1 accent-bar-shimmer"
  style={`background: linear-gradient(90deg, ${siteConfig.highlightColor}, ${siteConfig.accentColor}, ${siteConfig.neonPink}, ${siteConfig.accentColor}, ${siteConfig.highlightColor})`}
></div>

<section
  id="hero"
  class="relative py-16 md:py-24 lg:py-28 overflow-hidden"
  style={`background: ${siteConfig.bgPrimary}`}
>
  <!-- Background glow effects -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-15 blur-[100px]" style={`background: ${siteConfig.accentColor}`}></div>
    <div class="absolute bottom-10 -right-32 w-80 h-80 rounded-full opacity-10 blur-[100px]" style={`background: ${siteConfig.highlightColor}`}></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full opacity-5 blur-[120px]" style={`background: ${siteConfig.neonBlue}`}></div>
  </div>

  <!-- Floating tech icons -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="floating-icon absolute top-16 right-[15%] w-12 h-12 rounded-xl flex items-center justify-center text-2xl border border-white/5" style={`background: ${siteConfig.bgCard}; animation-delay: 0s`}>🔬</div>
    <div class="floating-icon absolute top-32 left-[10%] w-10 h-10 rounded-lg flex items-center justify-center text-xl border border-white/5" style={`background: ${siteConfig.bgCard}; animation-delay: 1s`}>⚙️</div>
    <div class="floating-icon absolute bottom-24 right-[20%] w-11 h-11 rounded-xl flex items-center justify-center text-xl border border-white/5" style={`background: ${siteConfig.bgCard}; animation-delay: 2s`}>🧪</div>
    <div class="floating-icon absolute bottom-32 left-[18%] w-10 h-10 rounded-lg flex items-center justify-center text-lg border border-white/5 hidden md:flex" style={`background: ${siteConfig.bgCard}; animation-delay: 0.5s`}>💡</div>
    <div class="floating-icon absolute top-48 right-[8%] w-9 h-9 rounded-lg flex items-center justify-center text-lg border border-white/5 hidden lg:flex" style={`background: ${siteConfig.bgCard}; animation-delay: 1.5s`}>📐</div>
  </div>

  <div class="relative max-w-6xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-16 items-center">
      <!-- Photo -->
      <div class="order-2 md:order-1 flex justify-center md:justify-start">
        <div class="relative hero-photo">
          <!-- Neon glow behind photo -->
          <div
            class="absolute -inset-4 rounded-2xl opacity-30 blur-xl"
            style={`background: linear-gradient(135deg, ${siteConfig.accentColor}, ${siteConfig.highlightColor})`}
          ></div>
          <!-- Outer ring with gradient border -->
          <div class="relative p-[3px] rounded-2xl" style={`background: linear-gradient(135deg, ${siteConfig.accentColor}, ${siteConfig.highlightColor})`}>
            <img
              src="/profile.jpg"
              alt={siteConfig.name}
              class="relative w-56 h-56 md:w-72 md:h-72 lg:w-80 lg:h-80 object-cover rounded-2xl"
              style={`border: 3px solid ${siteConfig.bgPrimary}`}
            />
          </div>
        </div>
      </div>

      <!-- Text Content -->
      <div class="order-1 md:order-2 text-center md:text-left">
        <p class="hero-subtitle text-sm md:text-base font-medium uppercase tracking-widest mb-3" style={`color: ${siteConfig.accentColor}`}>
          Hello, I'm
        </p>
        <h1
          class="hero-title text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-white mb-3"
        >
          {siteConfig.name.split(' ')[0]}{" "}
          <span style={`color: ${siteConfig.accentColor}`}>{siteConfig.name.split(' ').slice(1).join(' ')}</span>
        </h1>
        <p
          class="hero-subtitle text-lg md:text-xl font-light mb-4"
          style={`color: ${siteConfig.highlightColor}`}
        >
          {siteConfig.title}
        </p>
        <div
          class="w-20 h-1 mb-5 mx-auto md:mx-0 rounded-full"
          style={`background: linear-gradient(90deg, ${siteConfig.accentColor}, ${siteConfig.highlightColor})`}
        ></div>
        <p class="hero-description text-base md:text-lg text-gray-400 leading-relaxed mb-8 max-w-lg mx-auto md:mx-0">
          {siteConfig.tagline}
        </p>

        <!-- CTA Buttons -->
        <div class="hero-cta flex gap-4 justify-center md:justify-start mb-8">
          {siteConfig.social?.email && (
            <a
              href={`mailto:${siteConfig.social.email}`}
              class="neon-btn inline-flex items-center gap-2 px-7 py-3 rounded-full text-white font-semibold text-sm transition-all duration-300 hover:scale-105"
              style={`background: linear-gradient(135deg, ${siteConfig.accentColor}, ${siteConfig.highlightColor}); box-shadow: 0 0 25px ${siteConfig.accentColor}40`}
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              Contact Me
            </a>
          )}
          <a
            href="#projects"
            class="inline-flex items-center gap-2 px-7 py-3 rounded-full font-semibold text-sm transition-all duration-300 hover:scale-105 border"
            style={`border-color: ${siteConfig.accentColor}60; color: ${siteConfig.accentColor}`}
          >
            View Work
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>

        <!-- Social Links -->
        <div class="hero-social flex gap-3 justify-center md:justify-start">
          {siteConfig.social?.email && (
            <a href={`mailto:${siteConfig.social.email}`} class="icon-hover w-10 h-10 rounded-full flex items-center justify-center border border-white/10 text-white transition-all duration-300" style={`background: ${siteConfig.bgCard}`} aria-label="Email">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </a>
          )}
          {siteConfig.social?.linkedin && (
            <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="icon-hover w-10 h-10 rounded-full flex items-center justify-center border border-white/10 text-white transition-all duration-300" style={`background: ${siteConfig.bgCard}`} aria-label="LinkedIn">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          )}
          {siteConfig.social?.twitter && (
            <a href={siteConfig.social.twitter} target="_blank" rel="noopener noreferrer" class="icon-hover w-10 h-10 rounded-full flex items-center justify-center border border-white/10 text-white transition-all duration-300" style={`background: ${siteConfig.bgCard}`} aria-label="X">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M4 4l11.733 16h4.267l-11.733-16z M4 20l6.768-6.768m2.46-2.46l6.772-6.772"/></svg>
            </a>
          )}
          {siteConfig.social?.github && (
            <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="icon-hover w-10 h-10 rounded-full flex items-center justify-center border border-white/10 text-white transition-all duration-300" style={`background: ${siteConfig.bgCard}`} aria-label="GitHub">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            </a>
          )}
          {siteConfig.social?.instagram && (
            <a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer" class="icon-hover w-10 h-10 rounded-full flex items-center justify-center border border-white/10 text-white transition-all duration-300" style={`background: ${siteConfig.bgCard}`} aria-label="Instagram">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
          )}
          {siteConfig.social?.tiktok && (
            <a href={siteConfig.social.tiktok} target="_blank" rel="noopener noreferrer" class="icon-hover w-10 h-10 rounded-full flex items-center justify-center border border-white/10 text-white transition-all duration-300" style={`background: ${siteConfig.bgCard}`} aria-label="TikTok">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 0010.86 4.46V13a8.28 8.28 0 005.58 2.17v-3.45a4.85 4.85 0 01-3.77-1.26V6.69h3.77z"/></svg>
            </a>
          )}
          {siteConfig.social?.facebook && (
            <a href={siteConfig.social.facebook} target="_blank" rel="noopener noreferrer" class="icon-hover w-10 h-10 rounded-full flex items-center justify-center border border-white/10 text-white transition-all duration-300" style={`background: ${siteConfig.bgCard}`} aria-label="Facebook">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Stats Row -->
    {siteConfig.stats && siteConfig.stats.length > 0 && (
      <div class="hero-stats grid grid-cols-3 gap-4 md:gap-8 mt-16 pt-10 border-t border-white/10">
        {siteConfig.stats.map((stat, i) => (
          <div class="text-center stat-number">
            <div class="text-3xl md:text-4xl lg:text-5xl font-bold neon-text" style={`color: ${i === 0 ? siteConfig.accentColor : i === 1 ? siteConfig.highlightColor : siteConfig.neonPink}`}>
              {stat.value}
            </div>
            <div class="text-xs md:text-sm text-gray-400 mt-2">{stat.label}</div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
