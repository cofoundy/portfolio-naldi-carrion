---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const colors = [siteConfig.accentColor, siteConfig.highlightColor, siteConfig.neonPink, siteConfig.neonBlue];
---

{hasExperience && (
  <section id="experience" class="py-16 md:py-20" style={`background: ${siteConfig.bgSecondary}`}>
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="mb-12 reveal-left">
        <p class="text-sm font-medium uppercase tracking-widest mb-2" style={`color: ${siteConfig.highlightColor}`}>Career path</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white">Experience</h2>
        <div class="w-16 h-1 mt-3 rounded-full" style={`background: linear-gradient(90deg, ${siteConfig.accentColor}, ${siteConfig.highlightColor})`}></div>
      </div>

      {/* Horizontal Timeline (Desktop) */}
      <div class="hidden md:block relative mb-10 reveal stagger-1">
        <div class="absolute top-4 left-0 right-0 h-0.5 timeline-line" style={`background: linear-gradient(90deg, ${siteConfig.accentColor}, ${siteConfig.highlightColor}, ${siteConfig.neonPink})`}></div>
        <div class="flex justify-between">
          {siteConfig.experience.map((exp, index) => {
            const dotColor = colors[index % colors.length];
            return (
              <div class="relative flex flex-col items-center" style="flex: 1">
                <div class="w-8 h-8 rounded-full flex items-center justify-center z-10 border-2" style={`background: ${siteConfig.bgSecondary}; border-color: ${dotColor}; box-shadow: 0 0 12px ${dotColor}40`}>
                  <span class="text-xs font-bold" style={`color: ${dotColor}`}>{index + 1}</span>
                </div>
                <div class="mt-4 text-center">
                  <p class="text-sm font-semibold" style={`color: ${dotColor}`}>
                    {exp.dateRange.split(' - ')[0]}
                  </p>
                  <p class="text-xs mt-1 text-gray-500">{exp.company.split('/')[0].trim()}</p>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      {/* Experience Cards */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {siteConfig.experience.map((exp, index) => {
          const cardColor = colors[index % colors.length];
          return (
            <div
              class={`reveal stagger-${index + 2} card-hover p-6 rounded-xl border border-white/5 relative overflow-hidden`}
              style={`background: ${siteConfig.bgCard}`}
            >
              {/* Left accent bar */}
              <div class="absolute top-0 left-0 bottom-0 w-[2px]" style={`background: ${cardColor}`}></div>

              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-3 pl-3">
                <div>
                  <h3 class="text-lg font-semibold text-white">{exp.title}</h3>
                  <p class="text-base font-medium" style={`color: ${cardColor}`}>{exp.company}</p>
                </div>
                <span class="text-xs px-3 py-1 rounded-full mt-2 sm:mt-0 self-start border" style={`background: ${cardColor}10; color: ${cardColor}; border-color: ${cardColor}25`}>
                  {exp.dateRange}
                </span>
              </div>
              <ul class="space-y-2 pl-3">
                {exp.bullets.map((bullet) => (
                  <li class="flex items-start text-sm text-gray-400">
                    <span class="inline-block w-1.5 h-1.5 rounded-full mt-1.5 mr-2.5 flex-shrink-0" style={`background-color: ${cardColor}`} />
                    <Fragment set:html={bullet} />
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}
