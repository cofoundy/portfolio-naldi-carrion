---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
const colors = [siteConfig.accentColor, siteConfig.highlightColor, siteConfig.neonPink, siteConfig.neonBlue];
---

{hasEducation && (
  <section id="education" class="py-16 md:py-20" style={`background: ${siteConfig.bgPrimary}`}>
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="mb-12 reveal-left">
        <p class="text-sm font-medium uppercase tracking-widest mb-2" style={`color: ${siteConfig.highlightColor}`}>Academic background</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white">Education</h2>
        <div class="w-16 h-1 mt-3 rounded-full" style={`background: linear-gradient(90deg, ${siteConfig.accentColor}, ${siteConfig.highlightColor})`}></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {siteConfig.education.map((edu, index) => {
          const cardColor = colors[index % colors.length];
          return (
            <div
              class={`reveal stagger-${index + 1} card-hover flex gap-4 p-5 rounded-xl border border-white/5 relative overflow-hidden`}
              style={`background: ${siteConfig.bgCard}`}
            >
              {/* Top accent line */}
              <div class="absolute top-0 left-0 right-0 h-[2px]" style={`background: linear-gradient(90deg, ${cardColor}, transparent)`}></div>

              {/* Icon */}
              <div
                class="w-12 h-12 rounded-xl flex items-center justify-center text-xl flex-shrink-0 border"
                style={`background: ${cardColor}10; border-color: ${cardColor}25; box-shadow: 0 0 15px ${cardColor}10`}
              >
                🎓
              </div>

              <div class="flex-1 min-w-0">
                <h3 class="text-base font-semibold text-white">
                  <Fragment set:html={edu.degree} />
                </h3>
                <p class="text-sm" style={`color: ${cardColor}`}>{edu.school}</p>
                {edu.dateRange && (
                  <p class="text-xs mt-1 text-gray-500">{edu.dateRange}</p>
                )}
                {edu.achievements && edu.achievements.length > 0 && (
                  <ul class="mt-2 space-y-1.5">
                    {edu.achievements.map((a) => (
                      <li class="flex items-start text-xs text-gray-400">
                        <span class="inline-block w-1 h-1 rounded-full mt-1.5 mr-2 flex-shrink-0" style={`background-color: ${cardColor}`} />
                        <Fragment set:html={a} />
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}
