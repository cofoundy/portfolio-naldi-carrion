---
import { siteConfig } from "../config";

const services = [
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>`,
    title: "Innovation & R&D",
    description: "Driving technology innovation through research labs, digital fabrication, and patent development.",
    color: siteConfig.accentColor,
    ring: siteConfig.accentColor,
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>`,
    title: "Digital Fabrication",
    description: "FabAcademy certified — hands-on expertise in 3D printing, CNC, electronics, and IoT prototyping.",
    color: siteConfig.highlightColor,
    ring: siteConfig.highlightColor,
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>`,
    title: "Academic Impact",
    description: "4 patents co-authored, 7 publications in international journals, and PhD research in IT.",
    color: siteConfig.neonPink,
    ring: siteConfig.neonPink,
  },
];
---

<!-- Decorative separator -->
<div class="w-full h-px" style={`background: linear-gradient(90deg, transparent, ${siteConfig.accentColor}30, transparent)`}></div>

<section class="py-16 md:py-20" style={`background: ${siteConfig.bgSecondary}`}>
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-6">
      {services.map((service, i) => (
        <div class={`reveal stagger-${i + 1} text-center group`}>
          <!-- Circle icon (like DizMe's target/shield/lightbulb) -->
          <div class="relative mx-auto mb-6 w-20 h-20">
            <!-- Outer ring -->
            <div class="absolute inset-0 rounded-full border-2 transition-all duration-500 group-hover:scale-110" style={`border-color: ${service.ring}30`}></div>
            <!-- Inner circle with icon -->
            <div class="absolute inset-2 rounded-full flex items-center justify-center transition-all duration-500 group-hover:scale-105" style={`background: ${service.color}15; color: ${service.color}; box-shadow: 0 0 25px ${service.color}10`}>
              <Fragment set:html={service.icon} />
            </div>
          </div>
          <h3 class="text-lg font-semibold text-white mb-3">{service.title}</h3>
          <p class="text-sm text-gray-400 leading-relaxed max-w-xs mx-auto">{service.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>
