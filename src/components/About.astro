---
import { siteConfig } from "../config";
---

<section id="about" class="py-16 md:py-20" style={`background: ${siteConfig.bgSecondary}`}>
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
      <!-- Title -->
      <div class="lg:col-span-3 reveal-left">
        <p class="text-sm font-medium uppercase tracking-widest mb-2" style={`color: ${siteConfig.highlightColor}`}>Get to know me</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white">
          About
        </h2>
        <div class="w-16 h-1 mt-3 rounded-full" style={`background: linear-gradient(90deg, ${siteConfig.accentColor}, ${siteConfig.highlightColor})`}></div>
      </div>

      <!-- Bio -->
      <div class="lg:col-span-9 reveal stagger-1">
        <p class="text-base md:text-lg text-gray-300 leading-relaxed">
          <Fragment set:html={siteConfig.aboutMe} />
        </p>
      </div>
    </div>

    <!-- Skills -->
    <div class="mt-12 pt-8 border-t border-white/10 reveal stagger-2">
      <h3 class="text-sm font-semibold uppercase tracking-wider mb-5" style={`color: ${siteConfig.accentColor}`}>
        Expertise
      </h3>
      <div class="flex flex-wrap gap-2">
        {siteConfig.skills.map((skill, i) => (
          <span
            class="skill-hover px-4 py-2 rounded-full text-sm font-medium cursor-default border transition-all duration-300"
            style={`background: ${siteConfig.bgCard}; color: ${i % 3 === 0 ? siteConfig.accentColor : i % 3 === 1 ? siteConfig.highlightColor : siteConfig.neonPink}; border-color: ${i % 3 === 0 ? siteConfig.accentColor : i % 3 === 1 ? siteConfig.highlightColor : siteConfig.neonPink}30`}
          >
            {skill}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
