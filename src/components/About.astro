---
import { siteConfig } from "../config";
---

<section id="about" class="py-16 md:py-24 overflow-hidden" style={`background: ${siteConfig.bgPrimary}`}>
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left: Visual stats display (replaces duplicate photo) -->
      <div class="relative reveal-left">
        <!-- Background decorative shape -->
        <div class="absolute -top-4 -left-4 w-full h-full rounded-3xl rotate-3 opacity-15" style={`background: linear-gradient(135deg, ${siteConfig.accentColor}, ${siteConfig.highlightColor})`}></div>

        <!-- Stats card grid -->
        <div class="relative grid grid-cols-2 gap-4">
          <!-- Stat 1: big -->
          <div class="col-span-2 p-8 rounded-2xl border border-white/5 text-center" style={`background: ${siteConfig.bgCard}`}>
            <div class="text-5xl md:text-6xl font-bold neon-text mb-2" style={`color: ${siteConfig.accentColor}`}>{siteConfig.stats[0].value}</div>
            <div class="text-sm text-gray-400">{siteConfig.stats[0].label}</div>
            <div class="w-16 h-0.5 mx-auto mt-3 rounded-full" style={`background: ${siteConfig.accentColor}`}></div>
          </div>

          <!-- Stat 2 -->
          <div class="p-6 rounded-2xl border border-white/5 text-center" style={`background: ${siteConfig.bgCard}`}>
            <div class="text-4xl md:text-5xl font-bold neon-text mb-2" style={`color: ${siteConfig.highlightColor}`}>{siteConfig.stats[1].value}</div>
            <div class="text-xs text-gray-400">{siteConfig.stats[1].label}</div>
            <div class="w-12 h-0.5 mx-auto mt-3 rounded-full" style={`background: ${siteConfig.highlightColor}`}></div>
          </div>

          <!-- Stat 3 -->
          <div class="p-6 rounded-2xl border border-white/5 text-center" style={`background: ${siteConfig.bgCard}`}>
            <div class="text-4xl md:text-5xl font-bold neon-text mb-2" style={`color: ${siteConfig.neonPink}`}>{siteConfig.stats[2].value}</div>
            <div class="text-xs text-gray-400">{siteConfig.stats[2].label}</div>
            <div class="w-12 h-0.5 mx-auto mt-3 rounded-full" style={`background: ${siteConfig.neonPink}`}></div>
          </div>
        </div>
      </div>

      <!-- Right: Text content (DizMe style) -->
      <div class="reveal-right">
        <p class="text-sm font-medium uppercase tracking-[0.3em] mb-3" style={`color: ${siteConfig.highlightColor}`}>
          About Me
        </p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight mb-6">
          I Can Transform <br/>
          <span style={`color: ${siteConfig.accentColor}`}>Any Idea</span> Into Reality
        </h2>
        <p class="text-base text-gray-400 leading-relaxed mb-8">
          <Fragment set:html={siteConfig.aboutMe} />
        </p>

        <!-- CTA -->
        {siteConfig.social?.email && (
          <a
            href={`mailto:${siteConfig.social.email}`}
            class="neon-btn inline-flex items-center gap-2 px-8 py-3.5 rounded-full text-white font-semibold text-sm transition-all duration-300 hover:scale-105"
            style={`background: linear-gradient(135deg, ${siteConfig.highlightColor}, ${siteConfig.accentColor}); box-shadow: 0 0 25px ${siteConfig.highlightColor}30`}
          >
            Get in Touch
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        )}
      </div>
    </div>

    <!-- Skills section below -->
    <div class="mt-16 pt-10 border-t border-white/5 reveal stagger-2">
      <h3 class="text-sm font-semibold uppercase tracking-wider mb-6" style={`color: ${siteConfig.accentColor}`}>
        Expertise
      </h3>
      <div class="flex flex-wrap gap-2">
        {siteConfig.skills.map((skill, i) => (
          <span
            class="skill-hover px-4 py-2 rounded-full text-sm font-medium cursor-default border transition-all duration-300"
            style={`background: ${siteConfig.bgCard}; color: ${i % 3 === 0 ? siteConfig.accentColor : i % 3 === 1 ? siteConfig.highlightColor : siteConfig.neonPink}; border-color: ${i % 3 === 0 ? siteConfig.accentColor : i % 3 === 1 ? siteConfig.highlightColor : siteConfig.neonPink}30`}
          >
            {skill}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
